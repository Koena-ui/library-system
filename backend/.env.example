# Copy this file to ".env" and change the values to match your MySQL setup.
# XAMPP default: user "root" with an empty password.
PORT=5000
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=library_db

# Address(es) of the React app allowed to call this API (comma separated).
CLIENT_ORIGIN=http://localhost:5173
